<apex:page controller="ShopSphereInvoiceController" renderAs="pdf" applyBodyTag="false">
    <head>
        <style>
            body { font-family: 'Arial Unicode MS', sans-serif; font-size: 12px; }
            .header { text-align: center; margin-bottom: 20px; }
            .logo { font-size: 24px; font-weight: bold; color: #ff9900; }
            .title { font-size: 18px; font-weight: bold; margin-top: 10px; }
            .info-table { width: 100%; margin-bottom: 20px; }
            .info-table td { padding: 5px; vertical-align: top; }
            .items-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
            .items-table th, .items-table td { border: 1px solid #ddd; padding: 8px; text-align: left; }
            .items-table th { background-color: #f2f2f2; font-weight: bold; }
            .total-row { font-weight: bold; }
            .footer { margin-top: 40px; text-align: center; font-size: 10px; color: #777; }
        </style>
    </head>
    <body>
        <div class="header">
            <div class="logo">ShopSphere</div>
            <div class="title">Order Invoice / Summary</div>
        </div>
        
        <table class="info-table">
            <tr>
                <td>
                    <strong>Order Number:</strong> {!ord.Name}<br/>
                    <strong>Order Date:</strong> <apex:outputText value="{0,date,MM/dd/yyyy}"><apex:param value="{!ord.CreatedDate}"/></apex:outputText><br/>
                    <strong>Status:</strong> {!ord.Status__c}
                </td>
                <td style="text-align: right;">
                    <strong>Billed To:</strong><br/>
                    {!ord.Customer__r.Name}<br/>
                    {!ord.Customer__r.Email__c}<br/>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <strong>Delivery Address:</strong><br/>
                    {!ord.Delivery_Address__c}
                </td>
            </tr>
        </table>
        
        <table class="items-table">
            <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total</th>
            </tr>
            <apex:repeat value="{!ord.Order_Items__r}" var="item">
                <tr>
                    <td>{!item.Product__r.Name}</td>
                    <td>{!item.Quantity__c}</td>
                    <td>INR {!item.Price__c}</td>
                    <td>INR {!item.Total_Price__c}</td>
                </tr>
            </apex:repeat>
            <tr>
                <td colspan="3" class="total-row" style="text-align: right;">Grand Total:</td>
                <td class="total-row">INR {!ord.Total_Amount__c}</td>
            </tr>
        </table>
        
        <div class="footer">
            Thank you for shopping with ShopSphere! This is a computer generated invoice.
        </div>
    </body>
</apex:page>
